{
  "permissions": {
    "allow": [
      "Read(/home/lorenzo/**)",
      "Bash(pdfinfo /home/lorenzo/UniCode/**)",
      "Bash(pdftotext /home/lorenzo/UniCode/**)",
      "Bash(pandoc:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git mv:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(ls /home/lorenzo/UniCode/**)",
      "Bash(awk:*)",
      "Bash(git fetch:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd /home/lorenzo/UniCode && git add -A && git commit -m \"auto: $(date +%Y-%m-%d_%H:%M)\" 2>/dev/null || true'"
          }
        ]
      }
    ]
  }
}
